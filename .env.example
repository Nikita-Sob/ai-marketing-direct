# Скопируй в .env (или в /root/.hermes/.env на сервере) и заполни нужное.
# Секреты в git не попадают: .env добавлен в .gitignore.

# --- Telegram-бот (бесплатно, токен у @BotFather) ---
HSE_BOT_TOKEN=
# allowlist id через пробел/запятую; пусто = доступ всем
HSE_BOT_ALLOWED_USERS=

# --- Веб-интерфейс: ключ доступа в URL (?key=...) ---
WEB_TOKEN=

# --- Yandex Search API (Wordstat), ОПЦИОНАЛЬНО и платно ---
# Без этих ключей генератор полностью работает на встроенной семантической
# модели (бесплатный режим). С ключами фразы берутся из живого Wordstat.
YANDEX_SEARCH_API_KEY=
YANDEX_FOLDER_ID=
